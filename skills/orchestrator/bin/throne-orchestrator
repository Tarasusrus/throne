#!/usr/bin/env bash
set -euo pipefail

INTENT_ID="${THRONE_INTENT_ID:-}"
API_BASE="${THRONE_API_BASE:-http://localhost:5008}"
API_BASE="${API_BASE%/}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  throne-orchestrator list [--status STATUS]... [--json]
  throne-orchestrator run --intent ID [--vendor V] [--model M] [--effort E]
  throne-orchestrator review --intent ID [--vendor V] [--model M] [--effort E]
  throne-orchestrator stop --intent ID
  throne-orchestrator watch [--wait] [--timeout SECONDS]
  throne-orchestrator accept --intent ID --repo PATH [--into BRANCH] [--check CMD]
  throne-orchestrator accept --branch NAME --repo PATH [--into BRANCH] [--check CMD]

list — интенты тега текущего интента: id, статус, заголовок, карточки трекера.
Тег берётся из собственного интента, аргументом его не задают.

run — поднять work-сессию исполнителя на интенте своего тега. Сначала preview
(сервер сам контекст не собирает), потом run с собранным промптом. Живая сессия —
не ошибка: команда сообщает «уже работает» и выходит с кодом 0.

--model/--effort — ось запуска, ограниченная политикой (VENDOR_MODELS и
ALLOWED_EFFORTS в _orchestrator.py): effort только low|medium, у review ещё и
не сильнейшая модель вендора. Без флагов подставляется дефолт политики
(claude: sonnet + medium), а не серверный opus + high. Вендор без --vendor
берётся из настроек сервера. Запрещённые флаги отбиваются до единого HTTP-вызова,
вендор вне политики — сразу после чтения настроек, до создания чего-либо.
У opencode нет оси effort: модель ему не подставляется, потолок effort общий.

review — поднять независимого ревьюера на ветку исполнителя. Из тела
исполнителя вырезаются ровно три секции — `## Ветка`, `## Definition of Done`,
`## Для человека` — и складываются в новый ревью-интент того же тега; он
линкуется к интенту исполнителя, и на нём стартует сессия в режиме verify.
Ревьюер не видит ни `## Отчёт`, ни `## Для агента`, ни чата исполнителя.
Вердикт он пишет себе в тело разделом `## Вердикт`; читается через skill
`intent`. Флаги --vendor/--model/--effort — как у run. Один ревьюер за раз.
Печатает id ревью-интента первой строкой.

run на задаче в awaiting_operator (исполнитель вернулся, его сессия ещё жива)
сначала гасит прошлую сессию: возврат на доработку — новый запуск, а не «уже работает».

stop — погасить сессию исполнителя. Идемпотентно.

watch — картина по исполнителям: у кого живая сессия, кто ушёл в awaiting_operator
или done. Ревью-интент с записанным ## Вердикт не показывается — своё он сделал.
Живая сессия, упёршаяся в лимит вендора, показывается как «пауза до HH:MM»: она не
встала и не пропала, Throne поднимет её сам. Без флагов — мгновенный срез. С --wait
ждёт первого изменения, но не дольше --timeout (по умолчанию 600 с, потолок 900 с):
фонового наблюдения контур не даёт, ожидание живёт внутри хода. Уход в паузу по
лимиту и выход из неё изменением не считаются. Истёкший таймаут — не ошибка.

accept — детерминированная часть приёмки ветки исполнителя в клоне оркестратора:
ветка из `## Ветка` задачи, fetch, подтянуть основную ветку, слить --no-ff,
прогнать --check, запушить. На коде 0 задача и её ревью-интенты уходят в done —
сервер гасит их сессии и чистит воркспейсы. Ненулевой код ничего не закрывает.
--branch вместо --intent — только слияние, без Throne и без закрытия.
review новым раундом так же закрывает прошлые ревью-интенты задачи.
Ревью diff против DoD — до вызова, руками. Коды выхода называют причину:
  0  влито (или уже было влито — no-op)
  65 рабочее дерево не чистое или на основной ветке незапушенные коммиты — ничего не тронуто
  66 ветка не запушена на origin или без своих коммитов — исполнитель не сдал работу
  67 конфликт слияния — вернуть исполнителю на ребейз
  68 --check красный — вернуть исполнителю, слияние откачено
  69 push отклонён — локальная ветка возвращена к origin, повторить
  70 (--intent) ветка влита, но задачу закрыть не удалось — повторить accept
USAGE
}

die() {
  echo "throne-orchestrator: $*" >&2
  exit 64
}

require_intent() {
  [[ -n "${INTENT_ID}" ]] || die "THRONE_INTENT_ID is required"
}

# Клон репозиториев тега ждётся синхронно (CloneWaitSeconds = 300 на сервере),
# поэтому клиентский таймаут обязан быть заведомо больше серверного ожидания.
RUN_MAX_TIME=420

http_post() {
  local path="$1" body="$2" tmp status
  tmp="$(mktemp)"
  if ! status="$(printf '%s' "${body}" | curl -sS -o "${tmp}" -w '%{http_code}' \
    --max-time "${RUN_MAX_TIME}" \
    -X POST "${API_BASE}${path}" -H 'Content-Type: application/json' --data-binary @-)"; then
    rm -f "${tmp}"
    echo "throne-orchestrator: curl оборвался на POST ${path} (таймаут ${RUN_MAX_TIME}s)" >&2
    exit 1
  fi
  HTTP_STATUS="${status}"
  HTTP_BODY="$(cat "${tmp}")"
  rm -f "${tmp}"
}

http_post_or_fail() {
  http_post "$1" "$2"
  if [[ ! "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}" >&2
    echo "throne-orchestrator: POST $1 failed with HTTP ${HTTP_STATUS}" >&2
    exit 1
  fi
}

http_get() {
  local path="$1" tmp status
  tmp="$(mktemp)"
  if ! status="$(curl -sS -o "${tmp}" -w '%{http_code}' "${API_BASE}${path}")"; then
    rm -f "${tmp}"
    echo "throne-orchestrator: curl failed for GET ${path}" >&2
    exit 1
  fi
  HTTP_STATUS="${status}"
  HTTP_BODY="$(cat "${tmp}")"
  rm -f "${tmp}"
  if [[ ! "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}" >&2
    echo "throne-orchestrator: GET ${path} failed with HTTP ${HTTP_STATUS}" >&2
    exit 1
  fi
}

# Тег собственного интента — единственный источник скоупа. Несколько тегов на
# интенте оркестратора — ошибка постановки, а не повод молча взять первый.
own_tag() {
  require_intent
  http_get "/api/v1/intents/${INTENT_ID}"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" own-tag
}

cmd_list() {
  local json=0
  local -a statuses=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) [[ $# -ge 2 ]] || die "--status requires a value"; statuses+=("$2"); shift 2 ;;
      --json) json=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  local tag query
  tag="$(own_tag)"
  query="$(python3 "${HERE}/_orchestrator.py" list-query "${tag}" "${statuses[@]+"${statuses[@]}"}")"

  http_get "/api/v1/intents?${query}"
  local page="${HTTP_BODY}"

  # Карточки трекера лежат отдельным ресурсом на интенте (ADR-0052) — в списке их нет.
  local cards_dir id
  cards_dir="$(mktemp -d)"
  for id in $(printf '%s' "${page}" | python3 "${HERE}/_orchestrator.py" ids); do
    http_get "/api/v1/intents/${id}/task-tracker/cards"
    printf '%s' "${HTTP_BODY}" > "${cards_dir}/${id}.json"
  done
  # Пауза по лимиту вендора видна только пробнику сессии (ADR-0055) — тянем его для
  # живых и для интентов в work без сессии (могли умереть в паузе, ждут перезапуска).
  local sessions_dir
  sessions_dir="$(fetch_sessions "${tag}" "${page}")"

  local render="render"
  [[ ${json} -eq 1 ]] && render="render-json"
  printf '%s' "${page}" | python3 "${HERE}/_orchestrator.py" "${render}" "${cards_dir}" "${sessions_dir}"
  rm -rf "${cards_dir}" "${sessions_dir}"
}

# Ответы GET /terminal/session для живых исполнителей тега и интентов тега в work без
# сессии — в каталог <id>.json. Печатает путь каталога; вызывающий удаляет его сам. Только чтение.
fetch_sessions() {
  local tag="$1" page="$2" query sessions_dir id
  query="$(python3 "${HERE}/_orchestrator.py" list-query "${tag}")"
  sessions_dir="$(mktemp -d)"
  http_get "/api/v1/intents?${query}&terminal_running=true"
  for id in $(printf '%s\n%s' "${HTTP_BODY}" "${page}" | python3 "${HERE}/_orchestrator.py" session-candidates); do
    http_get "/api/v1/intents/${id}/terminal/session"
    printf '%s' "${HTTP_BODY}" > "${sessions_dir}/${id}.json"
  done
  printf '%s' "${sessions_dir}"
}

# Гард скоупа — клиентский: сервер разрешает запуск на любом интенте (ADR-0029,
# owner-оси нет). Дисциплину «только свой тег» держит эта проверка.
assert_own_tag() {
  local target="$1" tag
  tag="$(own_tag)"
  http_get "/api/v1/intents/${target}"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" assert-tag "${tag}" "${target}"
}

# Закрыть интент в done. Сессию гасим сами: сервер делает это на done только при
# включённом у интента cleanup_local_state_on_done (ADR-0026 §8), а сессия не должна
# пережить закрытие ни при каком флаге. Воркспейс чистит сервер — по тому же флагу.
close_intent() {
  local id="$1" reason="$2"
  http_post_or_fail "/api/v1/intents/${id}/terminal/kill" '{}'
  http_post_or_fail "/api/v1/intents/${id}/status" \
    "$(python3 "${HERE}/_orchestrator.py" status-payload done "${reason}")"
  echo "${id}: закрыт (done) — ${reason}"
}

# Незакрытые ревью-интенты задачи, чей JSON передан первым аргументом, — в done.
close_reviews() {
  local intent_json="$1" reason="$2" rid
  for rid in $(printf '%s' "${intent_json}" | python3 "${HERE}/_orchestrator.py" open-reviews); do
    close_intent "${rid}" "${reason}"
  done
}

# Запрещённая пара модель×effort отбивается здесь — до assert_own_tag и до preview,
# то есть до первого HTTP-вызова команды, а не после потраченного round-trip.
# Аргументы: mode vendor model effort.
check_launch() {
  local launch_err
  launch_err="$(python3 "${HERE}/_orchestrator.py" check-launch "$@" 2>&1)" \
    || die "${launch_err}"
}

# Политика выбирает модель по вендору, поэтому вендор нужен явно — без флага
# берём тот же дефолт, что взял бы сервер. Печатает вендора.
resolve_vendor() {
  if [[ -n "$1" ]]; then
    printf '%s' "$1"
    return 0
  fi
  http_get "/api/v1/settings/terminal"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" default-vendor
}

cmd_run() {
  local target="" vendor="" model="" effort=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || die "--intent requires a value"; target="$2"; shift 2 ;;
      --vendor) [[ $# -ge 2 ]] || die "--vendor requires a value"; vendor="$2"; shift 2 ;;
      --model) [[ $# -ge 2 ]] || die "--model requires a value"; model="$2"; shift 2 ;;
      --effort) [[ $# -ge 2 ]] || die "--effort requires a value"; effort="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${target}" ]] || die "run requires --intent ID"

  check_launch work "${vendor}" "${model}" "${effort}"
  vendor="$(resolve_vendor "${vendor}")"
  check_launch work "${vendor}" "${model}" "${effort}"
  assert_own_tag "${target}"
  # Исполнитель вернулся, а его сессия жива — иначе run ответил бы «уже работает» и
  # замечания ревью до него не дошли бы. Прошлый проход гасим, запускаем заново.
  if [[ "$(printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" intent-field status)" == "awaiting_operator" ]]; then
    http_post_or_fail "/api/v1/intents/${target}/terminal/kill" '{}'
    echo "${target}: прошлая сессия погашена перед перезапуском"
  fi

  spawn_session "${target}" work "${vendor}" "${model}" "${effort}"
}

# preview → run на интенте target в заданном режиме. Сервер не собирает
# system_prompt на run: без preview сессия стартует без правил и без задачи, и это
# выглядит успехом. Поэтому preview обязателен.
spawn_session() {
  local target="$1" mode="$2" vendor="$3" model="$4" effort="$5"
  http_post_or_fail "/api/v1/intents/${target}/terminal/preview" "{\"mode\":\"${mode}\"}"
  local payload
  payload="$(printf '%s' "${HTTP_BODY}" \
    | python3 "${HERE}/_orchestrator.py" run-payload "${vendor}" "${model}" "${effort}" "${mode}")"

  http_post "/api/v1/intents/${target}/terminal/run" "${payload}"
  if [[ "${HTTP_STATUS}" == "409" ]]; then
    if printf '%s' "${HTTP_BODY}" | grep -q "session_already_running"; then
      echo "${target}: сессия уже работает"
      return 0
    fi
    printf '%s\n' "${HTTP_BODY}" >&2
    die "конфликт версии текста интента ${target} — перечитай интент и повтори"
  fi
  if [[ ! "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}" >&2
    echo "throne-orchestrator: run на ${target} failed with HTTP ${HTTP_STATUS}" >&2
    exit 1
  fi
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" run-result "${target}"
}

# Независимое ревью (ADR-0054 §8): ревьюер — отдельная сессия на отдельном
# интенте, в котором нет ничего, кроме постановки. Вырезку делает python-хелпер,
# здесь — только HTTP: тело исполнителя → create → link → preview → run (verify).
cmd_review() {
  local target="" vendor="" model="" effort=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || die "--intent requires a value"; target="$2"; shift 2 ;;
      --vendor) [[ $# -ge 2 ]] || die "--vendor requires a value"; vendor="$2"; shift 2 ;;
      --model) [[ $# -ge 2 ]] || die "--model requires a value"; model="$2"; shift 2 ;;
      --effort) [[ $# -ge 2 ]] || die "--effort requires a value"; effort="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${target}" ]] || die "review requires --intent ID"
  check_launch verify "${vendor}" "${model}" "${effort}"
  # Вендор — до создания ревью-интента: отказ после create оставил бы сироту.
  vendor="$(resolve_vendor "${vendor}")"
  check_launch verify "${vendor}" "${model}" "${effort}"

  local tag
  tag="$(own_tag)"
  http_get "/api/v1/intents/${target}"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" assert-tag "${tag}" "${target}"
  local child_json="${HTTP_BODY}"

  # Тело ревью-интента — ровно три секции постановки; всё остальное ревьюеру не положено.
  local body_file
  body_file="$(mktemp)"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" review-body > "${body_file}" \
    || { rm -f "${body_file}"; exit 64; }

  # Новый раунд заменяет прошлые: их вердикты остаются читаемыми в done, сессии гаснут.
  close_reviews "${child_json}" "раунд ревью заменён новым"

  local create_payload review_id
  create_payload="$(python3 "${HERE}/_orchestrator.py" create-payload "${body_file}" "${tag}")"
  rm -f "${body_file}"
  http_post_or_fail "/api/v1/intents" "${create_payload}"
  review_id="$(printf '%s' "${HTTP_BODY}" | python3 -c 'import json,sys; print(json.load(sys.stdin)["id"])')"
  # id печатается сразу: интент уже существует, и если линк или запуск ниже упадут,
  # повторный `review` создал бы второй — а этот остался бы потерянным.
  echo "${review_id}"

  # Связь «ревью вытекает из задачи исполнителя» — по ней оркестратор находит вердикт.
  http_post_or_fail "/api/v1/intents/${review_id}/links" \
    "{\"to_id\":\"${target}\",\"blocking\":false,\"rationale\":\"независимое ревью ветки исполнителя\"}"

  spawn_session "${review_id}" verify "${vendor}" "${model}" "${effort}"
}

cmd_stop() {
  local target=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || die "--intent requires a value"; target="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${target}" ]] || die "stop requires --intent ID"
  assert_own_tag "${target}"

  http_post_or_fail "/api/v1/intents/${target}/terminal/kill" '{}'
  echo "${target}: сессия погашена"
}

# Только чтение: watch не двигает ни статусы, ни сессии.
watch_snapshot() {
  local tag="$1" running page query bodies_dir candidate
  # Тот же urlencode, что и в list: сырая интерполяция тега молча портит запрос.
  query="$(python3 "${HERE}/_orchestrator.py" list-query "${tag}")"
  http_get "/api/v1/intents?${query}&terminal_running=true"
  running="${HTTP_BODY}"
  http_get "/api/v1/intents?${query}"
  page="${HTTP_BODY}"
  # Список отдаёт обрезок текста — есть ли `## Вердикт`, видно только по полному
  # телу. Тянем его для вставших ревью-интентов, остальным лишний GET не нужен.
  bodies_dir="$(mktemp -d)"
  for candidate in $(printf '%s\n%s' "${running}" "${page}" | python3 "${HERE}/_orchestrator.py" verdict-candidates); do
    http_get "/api/v1/intents/${candidate}"
    printf '%s' "${HTTP_BODY}" > "${bodies_dir}/${candidate}.json"
  done
  # Сессия может стоять в паузе по лимиту вендора (ADR-0055): это видно только пробнику.
  # Тянем его для живых и для интентов в work без сессии — вторые могли умереть в паузе
  # и ждут перезапуска сторожем. Пауза — расписание, не событие: в срез идёт, в ключ — нет.
  local sessions_dir id
  sessions_dir="$(mktemp -d)"
  for id in $(printf '%s\n%s' "${running}" "${page}" | python3 "${HERE}/_orchestrator.py" session-candidates); do
    http_get "/api/v1/intents/${id}/terminal/session"
    printf '%s' "${HTTP_BODY}" > "${sessions_dir}/${id}.json"
  done
  printf '%s\n%s' "${running}" "${page}" | python3 "${HERE}/_orchestrator.py" watch-snapshot "${bodies_dir}" "${sessions_dir}"
  rm -rf "${bodies_dir}" "${sessions_dir}"
}

cmd_watch() {
  local wait=0 timeout=600
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait=1; shift ;;
      --timeout) [[ $# -ge 2 ]] || die "--timeout requires a value"; timeout="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ "${timeout}" =~ ^[0-9]+$ ]] || die "--timeout expects seconds"
  (( timeout > 900 )) && timeout=900

  local tag baseline current waited=0
  tag="$(own_tag)"
  baseline="$(watch_snapshot "${tag}")"

  if [[ ${wait} -eq 0 ]]; then
    printf '%s' "${baseline}" | python3 "${HERE}/_orchestrator.py" watch-render
    return 0
  fi

  local baseline_key current_key
  baseline_key="$(printf '%s' "${baseline}" | python3 "${HERE}/_orchestrator.py" watch-key)"
  while (( waited < timeout )); do
    sleep 15
    waited=$(( waited + 15 ))
    current="$(watch_snapshot "${tag}")"
    current_key="$(printf '%s' "${current}" | python3 "${HERE}/_orchestrator.py" watch-key)"
    if [[ "${current_key}" != "${baseline_key}" ]]; then
      printf '%s\n%s' "${baseline}" "${current}" | python3 "${HERE}/_orchestrator.py" watch-delta
      return 0
    fi
  done
  echo "без изменений за ${timeout} с — исполнители там же, где были"
  printf '%s' "${baseline}" | python3 "${HERE}/_orchestrator.py" watch-render
}

# Приёмка: только git, без HTTP. Ветку исполнителя не трогает, основную ветку
# двигает ровно в одном случае — чистое слияние и зелёная проверка; любой другой
# исход откатывает локальное состояние к origin. Каждый отказ — свой код выхода,
# чтобы агент ветвился по числу, а не парсил текст.
ACCEPT_DIRTY=65
ACCEPT_NOT_PUSHED=66
ACCEPT_CONFLICT=67
ACCEPT_CHECK_FAILED=68
ACCEPT_PUSH_REJECTED=69
ACCEPT_CLOSE_FAILED=70

accept_fail() {
  local code="$1"; shift
  echo "throne-orchestrator: $*" >&2
  exit "${code}"
}

cmd_accept() {
  local target="" branch="" repo="" into="" check=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || die "--intent requires a value"; target="$2"; shift 2 ;;
      --branch) [[ $# -ge 2 ]] || die "--branch requires a value"; branch="$2"; shift 2 ;;
      --repo) [[ $# -ge 2 ]] || die "--repo requires a value"; repo="$2"; shift 2 ;;
      --into) [[ $# -ge 2 ]] || die "--into requires a value"; into="$2"; shift 2 ;;
      --check) [[ $# -ge 2 ]] || die "--check requires a value"; check="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${target}" || -n "${branch}" ]] || die "accept requires --intent ID"
  [[ -z "${target}" || -z "${branch}" ]] \
    || die "--intent и --branch вместе нельзя: ветку задачи даёт её ## Ветка"
  [[ -n "${repo}" ]] || die "accept requires --repo PATH"
  # --branch — низкоуровневый режим «только слить», без Throne: ничего не закрывает.
  if [[ -n "${branch}" ]]; then
    accept_merge "${repo}" "${branch}" "${into}" "${check}"
    return 0
  fi
  assert_own_tag "${target}"
  local child_json="${HTTP_BODY}"
  branch="$(printf '%s' "${child_json}" | python3 "${HERE}/_orchestrator.py" branch-of)"

  # accept_fail выходит сам, так что сюда доходим только с влитой веткой.
  accept_merge "${repo}" "${branch}" "${into}" "${check}"
  # Ветка уже в основной: провал закрытия — не «не принято», а свой код. Повтор accept
  # даст no-op слияние и доделает закрытие.
  (
    close_reviews "${child_json}" "задача принята"
    if [[ "$(printf '%s' "${child_json}" | python3 "${HERE}/_orchestrator.py" intent-field status)" != "done" ]]; then
      close_intent "${target}" "принято и влито: ${branch}"
    fi
  ) || accept_fail "${ACCEPT_CLOSE_FAILED}" \
    "${branch} влита, но задачу закрыть не удалось — повтори accept, слияние будет no-op"
}

accept_merge() {
  local repo="$1" branch="$2" into="$3" check="$4"
  git -C "${repo}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "не git-репозиторий: ${repo}"

  # Чужие незакоммиченные правки не выбрасываем — отказ до любого сетевого шага.
  [[ -z "$(git -C "${repo}" status --porcelain)" ]] \
    || accept_fail "${ACCEPT_DIRTY}" "рабочее дерево ${repo} не чистое — приёмка не начата"

  git -C "${repo}" fetch -q --prune origin

  if [[ -z "${into}" ]]; then
    into="$(git -C "${repo}" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    [[ -n "${into}" ]] || die "не определить основную ветку origin — задай --into"
  fi
  # «origin/main» и «main» — одна и та же ветка; несуществующая — ошибка аргумента,
  # а не detached HEAD посреди приёмки.
  into="${into#origin/}"
  git -C "${repo}" rev-parse -q --verify "refs/remotes/origin/${into}" >/dev/null \
    || die "на origin нет ветки ${into} — проверь --into"

  # Локальная основная ветка — зеркало origin. Незапушенные коммиты на ней — чужая
  # работа, её не выбрасываем: это тот же отказ, что и грязное дерево.
  if git -C "${repo}" rev-parse -q --verify "refs/heads/${into}" >/dev/null \
    && [[ "$(git -C "${repo}" rev-list --count "origin/${into}..${into}")" != "0" ]]; then
    accept_fail "${ACCEPT_DIRTY}" "на ${into} есть незапушенные коммиты — приёмка не начата"
  fi
  git -C "${repo}" checkout -q "${into}" 2>/dev/null \
    || git -C "${repo}" checkout -q -b "${into}" "origin/${into}"
  git -C "${repo}" reset -q --hard "origin/${into}"

  git -C "${repo}" rev-parse -q --verify "refs/remotes/origin/${branch}" >/dev/null \
    || accept_fail "${ACCEPT_NOT_PUSHED}" "origin/${branch} нет — исполнитель не запушил ветку"

  if git -C "${repo}" merge-base --is-ancestor "origin/${branch}" "origin/${into}"; then
    # Пустая ветка (от основной, без своих коммитов) — тоже предок, но не влитая работа.
    # accept вливает --no-ff, поэтому сданная работа на first-parent цепочке не лежит.
    local tip
    tip="$(git -C "${repo}" rev-parse "origin/${branch}")"
    if [[ "$(git -C "${repo}" rev-list --first-parent "origin/${into}" | grep -cx "${tip}" || true)" != "0" ]]; then
      accept_fail "${ACCEPT_NOT_PUSHED}" "в ${branch} нет своих коммитов — исполнитель не сдал работу"
    fi
    echo "уже влито: ${branch} → ${into}"
    return 0
  fi

  # «Merge <ветка>» — формат самого git: commit-msg хуки (в Throne — трейлеры
  # Problem/Decision/Task) пропускают его как слияние, а «merge: …» отбивают.
  local before merge_log conflicts
  before="$(git -C "${repo}" rev-parse HEAD)"
  if ! merge_log="$(git -C "${repo}" merge -q --no-ff --no-edit -m "Merge ${branch}" "origin/${branch}" 2>&1)"; then
    conflicts="$(git -C "${repo}" diff --name-only --diff-filter=U 2>/dev/null || true)"
    git -C "${repo}" merge --abort 2>/dev/null || git -C "${repo}" reset -q --hard "${before}"
    git -C "${repo}" clean -fdq
    # Конфликт — исполнителю на ребейз, и он должен знать, где. Всё остальное
    # (unrelated histories, хук, identity) ребейзом не лечится — отдаём как есть.
    if [[ -n "${conflicts}" ]]; then
      printf 'конфликтуют:\n%s\n' "${conflicts}" >&2
      accept_fail "${ACCEPT_CONFLICT}" "конфликт слияния ${branch} → ${into} — вернуть исполнителю на ребейз"
    fi
    printf '%s\n' "${merge_log}" >&2
    accept_fail 1 "слияние ${branch} → ${into} не прошло не из-за конфликта — см. вывод git"
  fi

  if [[ -n "${check}" ]]; then
    if ! (cd "${repo}" && bash -c "${check}"); then
      # Дерево было чистым до приёмки, значит всё untracked — мусор самой проверки.
      git -C "${repo}" reset -q --hard "${before}"
      git -C "${repo}" clean -fdq
      accept_fail "${ACCEPT_CHECK_FAILED}" "проверка «${check}» красная — слияние откачено, вернуть исполнителю"
    fi
  fi

  if ! git -C "${repo}" push -q origin "${into}" 2>/dev/null; then
    git -C "${repo}" reset -q --hard "${before}"
    accept_fail "${ACCEPT_PUSH_REJECTED}" "push ${into} отклонён — локальная ветка возвращена к origin, повтори accept"
  fi
  echo "влито: ${branch} → ${into} ($(git -C "${repo}" rev-parse --short HEAD))"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 64; }
  local command="$1"
  shift
  case "${command}" in
    list) cmd_list "$@" ;;
    run) cmd_run "$@" ;;
    review) cmd_review "$@" ;;
    stop) cmd_stop "$@" ;;
    watch) cmd_watch "$@" ;;
    accept) cmd_accept "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: ${command}" ;;
  esac
}

main "$@"
