#!/usr/bin/env bash
set -euo pipefail

INTENT_ID="${THRONE_INTENT_ID:-}"
API_BASE="${THRONE_API_BASE:-http://localhost:5008}"
API_BASE="${API_BASE%/}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  throne-orchestrator list [--status STATUS]... [--json]
  throne-orchestrator run --intent ID [--vendor V] [--model M]
  throne-orchestrator stop --intent ID
  throne-orchestrator watch [--wait] [--timeout SECONDS]
  throne-orchestrator accept --repo PATH --branch NAME [--into BRANCH] [--check CMD]

list — интенты тега текущего интента: id, статус, заголовок, карточки трекера.
Тег берётся из собственного интента, аргументом его не задают.

run — поднять work-сессию исполнителя на интенте своего тега. Сначала preview
(сервер сам контекст не собирает), потом run с собранным промптом. Живая сессия —
не ошибка: команда сообщает «уже работает» и выходит с кодом 0.

stop — погасить сессию исполнителя. Идемпотентно.

watch — картина по исполнителям: у кого живая сессия, кто ушёл в awaiting_operator
или done. Без флагов — мгновенный срез. С --wait ждёт первого изменения, но не
дольше --timeout (по умолчанию 600 с, потолок 900 с): фонового наблюдения контур
не даёт, ожидание живёт внутри хода. Истёкший таймаут — не ошибка.

accept — детерминированная часть приёмки ветки исполнителя в клоне оркестратора:
fetch, подтянуть основную ветку, слить --no-ff, прогнать --check, запушить.
Ревью diff против DoD — до вызова, руками. Коды выхода называют причину:
  0  влито (или уже было влито — no-op)
  65 рабочее дерево не чистое или на основной ветке незапушенные коммиты — ничего не тронуто
  66 ветка не запушена на origin — исполнитель не сдал работу
  67 конфликт слияния — вернуть исполнителю на ребейз
  68 --check красный — вернуть исполнителю, слияние откачено
  69 push отклонён — локальная ветка возвращена к origin, повторить
USAGE
}

die() {
  echo "throne-orchestrator: $*" >&2
  exit 64
}

require_intent() {
  [[ -n "${INTENT_ID}" ]] || die "THRONE_INTENT_ID is required"
}

# Клон репозиториев тега ждётся синхронно (CloneWaitSeconds = 300 на сервере),
# поэтому клиентский таймаут обязан быть заведомо больше серверного ожидания.
RUN_MAX_TIME=420

http_post() {
  local path="$1" body="$2" tmp status
  tmp="$(mktemp)"
  if ! status="$(printf '%s' "${body}" | curl -sS -o "${tmp}" -w '%{http_code}' \
    --max-time "${RUN_MAX_TIME}" \
    -X POST "${API_BASE}${path}" -H 'Content-Type: application/json' --data-binary @-)"; then
    rm -f "${tmp}"
    echo "throne-orchestrator: curl оборвался на POST ${path} (таймаут ${RUN_MAX_TIME}s)" >&2
    exit 1
  fi
  HTTP_STATUS="${status}"
  HTTP_BODY="$(cat "${tmp}")"
  rm -f "${tmp}"
}

http_post_or_fail() {
  http_post "$1" "$2"
  if [[ ! "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}" >&2
    echo "throne-orchestrator: POST $1 failed with HTTP ${HTTP_STATUS}" >&2
    exit 1
  fi
}

http_get() {
  local path="$1" tmp status
  tmp="$(mktemp)"
  if ! status="$(curl -sS -o "${tmp}" -w '%{http_code}' "${API_BASE}${path}")"; then
    rm -f "${tmp}"
    echo "throne-orchestrator: curl failed for GET ${path}" >&2
    exit 1
  fi
  HTTP_STATUS="${status}"
  HTTP_BODY="$(cat "${tmp}")"
  rm -f "${tmp}"
  if [[ ! "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}" >&2
    echo "throne-orchestrator: GET ${path} failed with HTTP ${HTTP_STATUS}" >&2
    exit 1
  fi
}

# Тег собственного интента — единственный источник скоупа. Несколько тегов на
# интенте оркестратора — ошибка постановки, а не повод молча взять первый.
own_tag() {
  require_intent
  http_get "/api/v1/intents/${INTENT_ID}"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" own-tag
}

cmd_list() {
  local json=0
  local -a statuses=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status) [[ $# -ge 2 ]] || die "--status requires a value"; statuses+=("$2"); shift 2 ;;
      --json) json=1; shift ;;
      *) die "unknown argument: $1" ;;
    esac
  done

  local tag query
  tag="$(own_tag)"
  query="$(python3 "${HERE}/_orchestrator.py" list-query "${tag}" "${statuses[@]+"${statuses[@]}"}")"

  http_get "/api/v1/intents?${query}"
  local page="${HTTP_BODY}"

  # Карточки трекера лежат отдельным ресурсом на интенте (ADR-0052) — в списке их нет.
  local cards_dir id
  cards_dir="$(mktemp -d)"
  for id in $(printf '%s' "${page}" | python3 "${HERE}/_orchestrator.py" ids); do
    http_get "/api/v1/intents/${id}/task-tracker/cards"
    printf '%s' "${HTTP_BODY}" > "${cards_dir}/${id}.json"
  done

  local render="render"
  [[ ${json} -eq 1 ]] && render="render-json"
  printf '%s' "${page}" | python3 "${HERE}/_orchestrator.py" "${render}" "${cards_dir}"
  rm -rf "${cards_dir}"
}

# Гард скоупа — клиентский: сервер разрешает запуск на любом интенте (ADR-0029,
# owner-оси нет). Дисциплину «только свой тег» держит эта проверка.
assert_own_tag() {
  local target="$1" tag
  tag="$(own_tag)"
  http_get "/api/v1/intents/${target}"
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" assert-tag "${tag}" "${target}"
}

cmd_run() {
  local target="" vendor="" model=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || die "--intent requires a value"; target="$2"; shift 2 ;;
      --vendor) [[ $# -ge 2 ]] || die "--vendor requires a value"; vendor="$2"; shift 2 ;;
      --model) [[ $# -ge 2 ]] || die "--model requires a value"; model="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${target}" ]] || die "run requires --intent ID"
  assert_own_tag "${target}"

  # Сервер не собирает system_prompt на run: без preview исполнитель стартует без
  # правил и без задачи, и это выглядит успехом. Поэтому preview обязателен.
  http_post_or_fail "/api/v1/intents/${target}/terminal/preview" '{"mode":"work"}'
  local payload
  payload="$(printf '%s' "${HTTP_BODY}" \
    | python3 "${HERE}/_orchestrator.py" run-payload "${vendor}" "${model}")"

  http_post "/api/v1/intents/${target}/terminal/run" "${payload}"
  if [[ "${HTTP_STATUS}" == "409" ]]; then
    if printf '%s' "${HTTP_BODY}" | grep -q "session_already_running"; then
      echo "${target}: сессия уже работает"
      return 0
    fi
    printf '%s\n' "${HTTP_BODY}" >&2
    die "конфликт версии текста интента ${target} — перечитай интент и повтори"
  fi
  if [[ ! "${HTTP_STATUS}" =~ ^2 ]]; then
    printf '%s\n' "${HTTP_BODY}" >&2
    echo "throne-orchestrator: run на ${target} failed with HTTP ${HTTP_STATUS}" >&2
    exit 1
  fi
  printf '%s' "${HTTP_BODY}" | python3 "${HERE}/_orchestrator.py" run-result "${target}"
}

cmd_stop() {
  local target=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --intent) [[ $# -ge 2 ]] || die "--intent requires a value"; target="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${target}" ]] || die "stop requires --intent ID"
  assert_own_tag "${target}"

  http_post_or_fail "/api/v1/intents/${target}/terminal/kill" '{}'
  echo "${target}: сессия погашена"
}

# Только чтение: watch не двигает ни статусы, ни сессии.
watch_snapshot() {
  local tag="$1" running page query
  # Тот же urlencode, что и в list: сырая интерполяция тега молча портит запрос.
  query="$(python3 "${HERE}/_orchestrator.py" list-query "${tag}")"
  http_get "/api/v1/intents?${query}&terminal_running=true"
  running="${HTTP_BODY}"
  http_get "/api/v1/intents?${query}"
  page="${HTTP_BODY}"
  printf '%s\n%s' "${running}" "${page}" | python3 "${HERE}/_orchestrator.py" watch-snapshot
}

cmd_watch() {
  local wait=0 timeout=600
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait=1; shift ;;
      --timeout) [[ $# -ge 2 ]] || die "--timeout requires a value"; timeout="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ "${timeout}" =~ ^[0-9]+$ ]] || die "--timeout expects seconds"
  (( timeout > 900 )) && timeout=900

  local tag baseline current waited=0
  tag="$(own_tag)"
  baseline="$(watch_snapshot "${tag}")"

  if [[ ${wait} -eq 0 ]]; then
    printf '%s' "${baseline}" | python3 "${HERE}/_orchestrator.py" watch-render
    return 0
  fi

  while (( waited < timeout )); do
    sleep 15
    waited=$(( waited + 15 ))
    current="$(watch_snapshot "${tag}")"
    if [[ "${current}" != "${baseline}" ]]; then
      printf '%s\n%s' "${baseline}" "${current}" | python3 "${HERE}/_orchestrator.py" watch-delta
      return 0
    fi
  done
  echo "без изменений за ${timeout} с — исполнители там же, где были"
  printf '%s' "${baseline}" | python3 "${HERE}/_orchestrator.py" watch-render
}

# Приёмка: только git, без HTTP. Ветку исполнителя не трогает, основную ветку
# двигает ровно в одном случае — чистое слияние и зелёная проверка; любой другой
# исход откатывает локальное состояние к origin. Каждый отказ — свой код выхода,
# чтобы агент ветвился по числу, а не парсил текст.
ACCEPT_DIRTY=65
ACCEPT_NOT_PUSHED=66
ACCEPT_CONFLICT=67
ACCEPT_CHECK_FAILED=68
ACCEPT_PUSH_REJECTED=69

accept_fail() {
  local code="$1"; shift
  echo "throne-orchestrator: $*" >&2
  exit "${code}"
}

cmd_accept() {
  local repo="" branch="" into="" check=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --repo) [[ $# -ge 2 ]] || die "--repo requires a value"; repo="$2"; shift 2 ;;
      --branch) [[ $# -ge 2 ]] || die "--branch requires a value"; branch="$2"; shift 2 ;;
      --into) [[ $# -ge 2 ]] || die "--into requires a value"; into="$2"; shift 2 ;;
      --check) [[ $# -ge 2 ]] || die "--check requires a value"; check="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "${repo}" ]] || die "accept requires --repo PATH"
  [[ -n "${branch}" ]] || die "accept requires --branch NAME"
  git -C "${repo}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "не git-репозиторий: ${repo}"

  # Чужие незакоммиченные правки не выбрасываем — отказ до любого сетевого шага.
  [[ -z "$(git -C "${repo}" status --porcelain)" ]] \
    || accept_fail "${ACCEPT_DIRTY}" "рабочее дерево ${repo} не чистое — приёмка не начата"

  git -C "${repo}" fetch -q --prune origin

  if [[ -z "${into}" ]]; then
    into="$(git -C "${repo}" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    [[ -n "${into}" ]] || die "не определить основную ветку origin — задай --into"
  fi
  # «origin/main» и «main» — одна и та же ветка; несуществующая — ошибка аргумента,
  # а не detached HEAD посреди приёмки.
  into="${into#origin/}"
  git -C "${repo}" rev-parse -q --verify "refs/remotes/origin/${into}" >/dev/null \
    || die "на origin нет ветки ${into} — проверь --into"

  # Локальная основная ветка — зеркало origin. Незапушенные коммиты на ней — чужая
  # работа, её не выбрасываем: это тот же отказ, что и грязное дерево.
  if git -C "${repo}" rev-parse -q --verify "refs/heads/${into}" >/dev/null \
    && [[ "$(git -C "${repo}" rev-list --count "origin/${into}..${into}")" != "0" ]]; then
    accept_fail "${ACCEPT_DIRTY}" "на ${into} есть незапушенные коммиты — приёмка не начата"
  fi
  git -C "${repo}" checkout -q "${into}" 2>/dev/null \
    || git -C "${repo}" checkout -q -b "${into}" "origin/${into}"
  git -C "${repo}" reset -q --hard "origin/${into}"

  git -C "${repo}" rev-parse -q --verify "refs/remotes/origin/${branch}" >/dev/null \
    || accept_fail "${ACCEPT_NOT_PUSHED}" "origin/${branch} нет — исполнитель не запушил ветку"

  if git -C "${repo}" merge-base --is-ancestor "origin/${branch}" "origin/${into}"; then
    echo "уже влито: ${branch} → ${into}"
    return 0
  fi

  local before merge_log conflicts
  before="$(git -C "${repo}" rev-parse HEAD)"
  if ! merge_log="$(git -C "${repo}" merge -q --no-ff --no-edit -m "merge: ${branch}" "origin/${branch}" 2>&1)"; then
    conflicts="$(git -C "${repo}" diff --name-only --diff-filter=U 2>/dev/null || true)"
    git -C "${repo}" merge --abort 2>/dev/null || git -C "${repo}" reset -q --hard "${before}"
    git -C "${repo}" clean -fdq
    # Конфликт — исполнителю на ребейз, и он должен знать, где. Всё остальное
    # (unrelated histories, хук, identity) ребейзом не лечится — отдаём как есть.
    if [[ -n "${conflicts}" ]]; then
      printf 'конфликтуют:\n%s\n' "${conflicts}" >&2
      accept_fail "${ACCEPT_CONFLICT}" "конфликт слияния ${branch} → ${into} — вернуть исполнителю на ребейз"
    fi
    printf '%s\n' "${merge_log}" >&2
    accept_fail 1 "слияние ${branch} → ${into} не прошло не из-за конфликта — см. вывод git"
  fi

  if [[ -n "${check}" ]]; then
    if ! (cd "${repo}" && bash -c "${check}"); then
      # Дерево было чистым до приёмки, значит всё untracked — мусор самой проверки.
      git -C "${repo}" reset -q --hard "${before}"
      git -C "${repo}" clean -fdq
      accept_fail "${ACCEPT_CHECK_FAILED}" "проверка «${check}» красная — слияние откачено, вернуть исполнителю"
    fi
  fi

  if ! git -C "${repo}" push -q origin "${into}" 2>/dev/null; then
    git -C "${repo}" reset -q --hard "${before}"
    accept_fail "${ACCEPT_PUSH_REJECTED}" "push ${into} отклонён — локальная ветка возвращена к origin, повтори accept"
  fi
  echo "влито: ${branch} → ${into} ($(git -C "${repo}" rev-parse --short HEAD))"
}

main() {
  [[ $# -ge 1 ]] || { usage; exit 64; }
  local command="$1"
  shift
  case "${command}" in
    list) cmd_list "$@" ;;
    run) cmd_run "$@" ;;
    stop) cmd_stop "$@" ;;
    watch) cmd_watch "$@" ;;
    accept) cmd_accept "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: ${command}" ;;
  esac
}

main "$@"
